# =============================================================================
# JobFlow AI — Environment Variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# ----- LLM provider -----------------------------------------------------------
# Which provider to use for AI calls. Two levels of control:
#
# 1. Simple mode — one provider for everything:
#      LLM_PROVIDER=gemini   → free during dev/testing
#      LLM_PROVIDER=openai   → gpt-4o, production-grade (default)
#
# 2. Hybrid mode (recommended for launch) — override per tier:
#      LLM_SMART_PROVIDER=openai   → analyze, predict, generate, insights
#                                    (high-impact creative calls)
#      LLM_FAST_PROVIDER=gemini    → keyword enrichment (background labels)
#    Anything not set per-tier falls back to LLM_PROVIDER, then to openai.
#
# Recommendation: keep LLM_PROVIDER=gemini for local dev. Before launch,
# set LLM_SMART_PROVIDER=openai (you pay for the audit quality you sell)
# and LLM_FAST_PROVIDER=gemini (you save ~30¢/user/mo on background work).
LLM_PROVIDER=gemini

# Per-tier overrides (leave blank to use LLM_PROVIDER for both).
LLM_SMART_PROVIDER=
LLM_FAST_PROVIDER=

# OpenAI — required when any tier resolves to "openai". Get one from
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini — required when any tier resolves to "gemini". Free up to
# ~1500 requests/day on gemini-2.5-flash. Get one from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ----- Firecrawl (web scraping) ----------------------------------------------
# Optional if you use Apify instead. Sign up at https://firecrawl.dev.
FIRECRAWL_API_KEY=fc-...

# ----- Apify (preferred free scraping for Fiverr) ----------------------------
# Free plan includes $5/mo credits, no card required: https://console.apify.com
# When set, JobFlow uses Apify BEFORE Firecrawl for gig + search scrapes.
APIFY_API_TOKEN=
# Optional. Default: automation-lab~fiverr-scraper
# Use username~actor-name form (slash is also accepted).
APIFY_FIVERR_ACTOR_ID=automation-lab~fiverr-scraper

# ----- Supabase (auth + database) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ----- Flutterwave (subscriptions + credit top-ups) --------------------------
# Dashboard → Settings → API → Secret key (use TEST key while developing)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# Dashboard → Settings → Webhooks → create endpoint + secret hash
# URL: https://your-domain/api/billing/webhook
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_CURRENCY=USD

# Payment Plan IDs from Payments → Payment plans (must be Active + matching USD amounts)
FLUTTERWAVE_PLAN_PRO_MONTHLY=
FLUTTERWAVE_PLAN_PRO_YEARLY=
FLUTTERWAVE_PLAN_AGENCY_MONTHLY=
FLUTTERWAVE_PLAN_AGENCY_YEARLY=

# One-time top-ups (USD cents). Charged via Flutterwave Standard — no plan IDs.
# Must stay in sync with lib/stripe-packs.ts display amounts.
FLUTTERWAVE_TOPUP_5_AMOUNT_CENTS=399
FLUTTERWAVE_TOPUP_15_AMOUNT_CENTS=999
FLUTTERWAVE_TOPUP_30_AMOUNT_CENTS=1799

# Top-ups use amounts above (no separate Flutterwave Payment Plan ids).

# --- Monthly credit limits (overrides) --------------------------------------
# Defaults are 2 / 20 / 100 — override here if you change plan pricing.
# The legacy PREMIUM_MONTHLY_SCAN_LIMIT still works as a synonym for Pro.
# FREE_MONTHLY_SCAN_LIMIT=2
# PRO_MONTHLY_SCAN_LIMIT=20
# AGENCY_MONTHLY_SCAN_LIMIT=100

# ----- Cron job auth ---------------------------------------------------------
# Used by Vercel Cron to authenticate calls to /api/cron/*. Set to a long
# random string in production; can be anything during local dev.
CRON_SECRET=changeme

# ----- Admin dashboard -------------------------------------------------------
# Comma-separated emails allowed to open /admin (read-only user list).
# Example: ADMIN_EMAILS=you@jobflow.win,ops@jobflow.win
ADMIN_EMAILS=

# ----- Support ---------------------------------------------------------------
# Shown on the in-app Help tab (mailto). Defaults to support@jobflow.win.
NEXT_PUBLIC_SUPPORT_EMAIL=support@jobflow.win

# ----- App URL ---------------------------------------------------------------
# Used in shareable audit links, Flutterwave redirects, etc.
# Local: http://localhost:3000
# Production: https://jobflow.win
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Alias kept for older docs / tooling — prefer NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Optional debugging -----------------------------------------------------
# Set to "1" to print notification email events to the console (no real send).
NOTIFY_EMAIL_DEBUG=
